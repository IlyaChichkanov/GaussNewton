# Custom user directories
# acados-кодоген пишется рядом с ноутбуком (Path(os.getcwd())/'tmp_generated'),
# поэтому правило не привязано к месту: ноутбуки переезжают между папками
**/tmp_generated/

#Ignore vscode AI rules
.github/instructions/codacy.instructions.md
.codacy/

# Сырые логи экспериментов (данные, не код).
# Форма `datasets/*`, а не `datasets/`: git не спускается внутрь игнорируемого
# каталога, и тогда README.md в нём нельзя было бы переоткрыть исключением.
experiments/datasets/*
!experiments/datasets/README.md
# Правила на случай, если данные окажутся мимо datasets/ (** — на любой глубине)
experiments/**/*.csv
experiments/**/*.blf

# Артефакты прогонов
mhe_plot.png
mhe_results.html
mhe/mhe_jupyter.html
